{
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "dist/public",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/[...path]"
    },
    {
      "source": "/manus-storage/:path*",
      "destination": "/api/manus-storage/:path*"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/loveoffice-console-5h9q2x7m4k8v1r6d3",
      "destination": "/index.html"
    },
    {
      "source": "/site/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/site/:slug/settings",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/purge-expired",
      "schedule": "0 0 * * *"
    }
  ]
}
